{
  "name": "stackwahl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm content:validate && pnpm search:index && next dev",
    "build": "pnpm content:validate --production && pnpm search:index --production && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm content:validate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:css": "node scripts/check-css.ts",
    "placeholders": "node scripts/placeholders.ts",
    "check": "pnpm format:check && pnpm lint && pnpm lint:copy && pnpm typecheck && pnpm test && pnpm build && pnpm check:css",
    "content:validate": "node scripts/validate-content.ts",
    "search:index": "node scripts/build-search-index.ts",
    "lint:copy": "node scripts/lint-copy.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@content-collections/core": "0.15.3",
    "@content-collections/next": "0.2.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0"
}
