# Copy to .env.local and fill in. Never commit real values.
# Variables are added here in the same commit as the code that reads them.

# Mail transport. "outbox" writes mails to .outbox/ (development and tests only).
# Without a transport the contact form and the newsletter stay hidden.
MAIL_TRANSPORT=
# Sender address for system mails, e.g. noreply@stackwahl.de (verified at the provider).
MAIL_FROM=
# Recipient of the contact form. Falls back to legal.email in site.config.ts.
CONTACT_TO=
# At least 32 random characters. Seals newsletter confirmation links.
NEWSLETTER_SECRET=

# Preview builds only (pnpm build:preview): show drafts. Never set in production.
STACKWAHL_SHOW_DRAFTS=
